---
import '../styles/global.css';
import { sitio, rutas, t, type Idioma } from '../config';

interface Props {
  idioma: Idioma;
  // URL de esta misma página en el otro idioma.
  alterna: string;
  titulo?: string;
  activo?: 'proyectos' | 'sobreMi';
  // Solo en la portada en castellano: si el visitante eligió inglés antes, se le lleva a /en/.
  recordarIdioma?: boolean;
  // Landing: solo la firma arriba a la izquierda, sin menú ni pie.
  minimo?: boolean;
}

const { idioma, alterna, titulo, activo, recordarIdioma = false, minimo = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} — ${sitio.firma}` : sitio.firma;
const urlEs = new URL(idioma === 'es' ? Astro.url.pathname : alterna, Astro.site);
const urlEn = new URL(idioma === 'en' ? Astro.url.pathname : alterna, Astro.site);

const enlaces = [
  { clave: 'proyectos', texto: t.proyectosMenu[idioma], href: rutas.proyectos[idioma] },
  { clave: 'sobreMi', texto: t.sobreMi[idioma], href: rutas.sobreMi[idioma] },
] as const;
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={t.descripcion[idioma]} />
    <link rel="alternate" hreflang="es" href={urlEs} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      recordarIdioma && (
        <script is:inline>
          try {
            if (localStorage.getItem('idioma') === 'en') location.replace('/b/en/');
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body>
    <header class="cabecera">
      <a class="firma" href={rutas.inicio[idioma]}>{sitio.firma}</a>
      {!minimo && <>
      <button class="abrir-menu" type="button" aria-expanded="false" aria-controls="menu">
        {t.menu[idioma]}
      </button>
      <nav id="menu" class="menu">
        <ul>
          {
            enlaces.map((e) => (
              <li>
                <a href={e.href} class:list={{ activo: activo === e.clave }} aria-current={activo === e.clave ? 'page' : undefined}>
                  {e.texto}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="idiomas">
          <span class:list={{ activo: idioma === 'es' }}>{idioma === 'es' ? 'ES' : <a href={alterna} data-idioma="es" hreflang="es">ES</a>}</span>
          /
          <span class:list={{ activo: idioma === 'en' }}>{idioma === 'en' ? 'EN' : <a href={alterna} data-idioma="en" hreflang="en">EN</a>}</span>
        </p>
      </nav>
      </>}
    </header>

    <slot />

    {!minimo && <footer class="pie">
      <a href={`mailto:${sitio.email}`}>{sitio.email}</a>
      <a href={`https://instagram.com/${sitio.instagram}`} rel="me">@{sitio.instagram}</a>
      {sitio.telefono && <a href={`tel:${sitio.telefono.replace(/\s/g, '')}`}>{sitio.telefono}</a>}
      <span class="gris">© {new Date().getFullYear()} {sitio.firma}</span>
    </footer>}

    <script>
      const boton = document.querySelector<HTMLButtonElement>('.abrir-menu');
      boton?.addEventListener('click', () => {
        const abierto = document.body.classList.toggle('menu-abierto');
        boton!.setAttribute('aria-expanded', String(abierto));
      });

      document.querySelectorAll<HTMLAnchorElement>('[data-idioma]').forEach((a) => {
        a.addEventListener('click', () => {
          try {
            localStorage.setItem('idioma', a.dataset.idioma!);
          } catch {}
        });
      });
    </script>
  </body>
</html>

<style>
  .cabecera {
    /* La cabecera no se funde al cambiar de página: solo cambia lo de debajo. */
    view-transition-name: cabecera;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 12px var(--margen);
    height: var(--cabecera);
    background: var(--papel);
  }

  .menu {
    display: none;
  }

  /* El idioma elegido va en cursiva; la página activa del menú, subrayada (Elías, 6/11/2026). */
  .idiomas .activo {
    font-style: italic;
  }

  .menu a.activo {
    text-decoration-color: currentColor;
  }

  .idiomas a {
    color: var(--gris);
  }

  /* Móvil: el menú se abre a pantalla completa. */
  :global(body.menu-abierto) .menu {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: fixed;
    inset: var(--cabecera) 0 0 0;
    padding: 24px var(--margen) var(--margen);
    background: var(--papel);
    font-size: 2.4rem;
    line-height: 1.1;
    animation: menu-entra 0.25s ease-out;
  }

  @keyframes menu-entra {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  :global(body.menu-abierto) .idiomas {
    font-size: var(--texto);
  }

  @media (min-width: 768px) {
    .cabecera {
      display: grid;
      grid-template-columns: repeat(3, 1fr) auto;
    }

    .abrir-menu {
      display: none;
    }

    .menu,
    :global(body.menu-abierto) .menu {
      display: contents;
      position: static;
      font-size: inherit;
    }

    .menu ul {
      display: contents;
    }
  }

  .pie {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    padding: 64px var(--margen) var(--margen);
  }
</style>
