---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { rutas, t, type Idioma } from '../config';
import { getProyectos } from '../../proyectos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const otro: Idioma = idioma === 'es' ? 'en' : 'es';

// Las portadas de todos los proyectos, en su orden, para el cuadro de la esquina.
const proyectos = await getProyectos();
const portadas = await Promise.all(
  proyectos.map(async (p) => (await getImage({ src: p.data.portada, width: 900, format: 'webp' })).src),
);
---

<Base idioma={idioma} alterna={rutas.inicio[otro]} recordarIdioma={idioma === 'es'} minimo>
  <main class="inicio">
    <h1 class="visualmente-oculto">eliaaas</h1>

    <!-- Sin texto: solo un cuadro abajo a la derecha donde pasan las portadas. Al hacer clic, a Proyectos. -->
    <a class="cuadro" href={rutas.proyectos[idioma]} aria-label={`${t.verProyectos[idioma]} (${proyectos.length})`}>
      <img src={portadas[0]} alt="" decoding="async" />
    </a>
    <script type="application/json" id="portadas-datos" set:html={JSON.stringify(portadas)} />
  </main>
</Base>

<script>
  // Las portadas simplemente se suceden en el mismo cuadro, sin transición.
  const CADENCIA = 1400;

  const portadas: string[] = JSON.parse(document.getElementById('portadas-datos')!.textContent!);
  const cuadro = document.querySelector<HTMLElement>('.cuadro')!;
  const img = cuadro.querySelector('img')!;
  const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let i = 0;
  let temporizador: number | undefined;

  // Precarga para que ninguna salga a medias.
  portadas.forEach((src) => (new Image().src = src));

  function arrancar() {
    clearInterval(temporizador);
    if (sinMovimiento || portadas.length < 2) return;
    temporizador = window.setInterval(() => {
      i = (i + 1) % portadas.length;
      img.src = portadas[i];
    }, CADENCIA);
  }

  // Al pasar el cursor se detiene, para poder mirar la portada.
  cuadro.addEventListener('pointerenter', () => clearInterval(temporizador));
  cuadro.addEventListener('pointerleave', arrancar);
  document.addEventListener('visibilitychange', () => (document.hidden ? clearInterval(temporizador) : arrancar()));
  arrancar();
</script>

<style>
  .inicio {
    position: relative;
    min-height: 100svh;
  }

  .cuadro {
    position: absolute;
    right: var(--margen);
    bottom: var(--margen);
    display: block;
    width: clamp(180px, 24vw, 360px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--lamina-clara);
  }

  .cuadro img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .cuadro:hover img {
    transform: scale(1.02);
  }
</style>
