---
import Proyecto from '../../../views/Proyecto.astro';
import { getProyectos } from '../../../proyectos';

export async function getStaticPaths() {
  const proyectos = await getProyectos();
  return proyectos.map((proyecto) => ({ params: { slug: proyecto.data.slug }, props: { proyecto } }));
}

const { proyecto } = Astro.props;
---

<Proyecto idioma="en" proyecto={proyecto} />
